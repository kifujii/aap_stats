# aapstats の設定ファイルの見本
# 管理者が /etc/aapstats/config.ini にコピーし、全ユーザーで共有する（手順は README の「接続の設定」）
# 各ユーザーは環境変数 AAPSTATS_CONFIG=/etc/aapstats/config.ini でこのファイルを指定する
# token_file は必ず絶対パスで書く（~ は実行したユーザーのホームと解釈されるため）
# プロファイル名を [default] にすると、--profile を省略したときにそのプロファイルを使う
# 同じ AAP を 2 つのプロファイルに書かない（履歴が 2 つのファイルに分かれ、sync が二重になる）

[source]
# 移行元（AAP 2.5）
host = https://aap-source.example.com
token_file = /etc/aapstats/source.token
verify_ssl = true
# ca_file = /etc/pki/tls/certs/internal-ca.pem
api_version = auto

[target]
# 移行先（AAP 2.6）
host = https://aap-target.example.com
token_file = /etc/aapstats/target.token
api_version = auto

# 任意の設定（省略時の既定値）
# timezone = Asia/Tokyo
# timeout = 60
# max_workers = 4
# request_interval = 0
